# ==========================================
# EduSense AI - Git Ignore
# ==========================================

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables / API keys
.env
.env.*
!.env.example

# Uploaded files
uploads/*
!uploads/.gitkeep

# Streamlit secrets
.streamlit/secrets.toml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Model/cache files
.cache/
*.cache

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log